<% if (user.role==='admin' || user.role==='content_mgr' ) { %>
  <!DOCTYPE html>
  <html lang="ru">

  <head>
    <meta charset="UTF-8">
    <title>Изображения товаров</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/css/admin.css" rel="stylesheet">
  </head>

  <body class="bg-slate-50 min-h-screen">
    <%- include('../partials/admin-navbar', { user }) %>

      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pt-20">
        <div class="md:flex md:items-center md:justify-between mb-6">
          <div class="min-w-0 flex-1">
            <h2 class="text-2xl font-bold leading-7 text-slate-900 sm:truncate sm:text-3xl sm:tracking-tight">
              Изображения товаров
            </h2>
            <p class="mt-1 text-sm text-slate-500">
              Загрузка и управление изображениями для существующих товаров
            </p>
          </div>
        </div>

        <% if (products.length===0) { %>
          <div class="rounded-md bg-blue-50 p-4">
            <div class="ml-3 text-sm text-blue-700">В системе пока нет товаров.</div>
          </div>
          <% } else { %>
            <div class="mt-8 flow-root">
              <div class="-mx-4 -my-2 overflow-x-auto sm:-mx-6 lg:-mx-8">
                <div class="inline-block min-w-full py-2 align-middle sm:px-6 lg:px-8">
                  <div class="overflow-hidden shadow ring-1 ring-black ring-opacity-5 sm:rounded-lg">
                    <table class="min-w-full divide-y divide-slate-300">
                      <thead class="bg-slate-50">
                        <tr>
                          <th scope="col" class="py-3.5 pl-4 pr-3 text-left text-sm font-semibold text-slate-900 sm:pl-6">
                            Фото</th>
                          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">ID</th>
                          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">Название
                          </th>
                          <th scope="col" class="px-3 py-3.5 text-left text-sm font-semibold text-slate-900">
                            Изображений</th>
                          <th scope="col" class="relative py-3.5 pl-3 pr-4 sm:pr-6">
                            <span class="sr-only">Действия</span>
                          </th>
                        </tr>
                      </thead>
                      <tbody class="divide-y divide-slate-200 bg-white">
                        <% products.forEach(product=> { %>
                          <% const primary=product.images && product.images[0]; %>
                            <tr class="hover:bg-slate-50">
                              <td class="whitespace-nowrap py-3 pl-4 pr-3 sm:pl-6">
                                <img src="<%= primary ? primary.url : '/images/product-placeholder.svg' %>"
                                  alt="<%= product.name %>"
                                  class="h-12 w-12 rounded-lg object-cover ring-1 ring-slate-200 bg-slate-50" />
                              </td>
                              <td class="whitespace-nowrap px-3 py-4 text-sm font-medium text-slate-900">
                                <%= product.id %>
                              </td>
                              <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                                <%= product.name %>
                              </td>
                              <td class="whitespace-nowrap px-3 py-4 text-sm text-slate-500">
                                <%= product._count.images %>
                              </td>
                              <td class="relative whitespace-nowrap py-4 pl-3 pr-4 text-right text-sm font-medium sm:pr-6">
                                <a href="/admin/product-images/<%= product.id %>"
                                  class="inline-flex items-center rounded-md bg-indigo-50 px-2 py-1 text-sm font-semibold text-indigo-600 ring-1 ring-inset ring-indigo-500/10 hover:bg-indigo-100">
                                  <svg class="w-4 h-4 mr-1" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                      d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                  </svg>
                                  Управлять
                                </a>
                              </td>
                            </tr>
                            <% }) %>
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
            <% } %>
      </div>
  </body>

  </html>
  <% } else { %>
    <!DOCTYPE html>
    <html lang="ru">

    <head>
      <meta charset="UTF-8">
      <title>Доступ запрещен</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <script src="https://cdn.tailwindcss.com"></script>
      <link href="/css/admin.css" rel="stylesheet">
    </head>

    <body class="bg-slate-50 min-h-screen">
      <%- include('../partials/admin-navbar', { user }) %>

      <div class="flex min-h-screen items-center justify-center px-4 py-8 pt-20">
        <div class="w-full max-w-md text-center">
          <div class="rounded-lg bg-white p-8 shadow-lg">
            <h1 class="mt-4 text-2xl font-bold text-slate-900">Доступ запрещен</h1>
            <p class="mt-2 text-slate-600">У вас нет прав для просмотра этой страницы.</p>
            <a href="/admin/dashboard"
              class="mt-6 inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
              Вернуться на главную
            </a>
          </div>
        </div>
      </div>
    </body>

    </html>
    <% } %>
