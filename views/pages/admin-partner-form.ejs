<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <title><%= service && service.id ? 'Настройки услуги' : 'Новая услуга' %> — POSA Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/css/admin.css" rel="stylesheet">
</head>

<body class="bg-slate-50 min-h-screen">
    <%- include('../partials/admin-navbar', { user }) %>
        <% const isEdit=service && service.id; %>

            <div class="max-w-2xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pt-20">
                <a href="/admin/partners" class="text-sm text-slate-500 hover:text-slate-700">&larr; Партнёрские
                    сети</a>
                <h2 class="text-2xl font-bold text-slate-900 mt-2 mb-6">
                    <%= isEdit ? 'Настройки услуги' : 'Новая услуга' %>
                </h2>

                <% if (error) { %>
                    <div class="mb-6 rounded-md bg-red-50 p-4 text-sm text-red-700 ring-1 ring-red-200">
                        <%= error %>
                    </div>
                    <% } %>

                        <form method="POST"
                            action="<%= isEdit ? `/admin/partners/${service.id}/edit` : '/admin/partners/add' %>"
                            class="bg-white rounded-lg shadow-sm ring-1 ring-slate-200 p-6 space-y-5">

                            <div>
                                <label class="block text-sm font-medium text-slate-700">Партнёр</label>
                                <% if (isEdit) { %>
                                    <p class="mt-1 text-sm text-slate-900 font-mono">
                                        <%= service.partner %>
                                    </p>
                                    <% } else { %>
                                        <select name="partner"
                                            class="mt-1 block w-full rounded-md border-slate-300 shadow-sm text-sm">
                                            <% partners.forEach(p=> { %>
                                                <option value="<%= p %>" <%=service && service.partner===p ? 'selected'
                                                    : '' %>>
                                                    <%= p %>
                                                </option>
                                                <% }) %>
                                        </select>
                                        <% } %>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-700">serviceId партнёра</label>
                                <% if (isEdit) { %>
                                    <p class="mt-1 text-sm text-slate-900 font-mono">
                                        <%= service.serviceId %>
                                    </p>
                                    <p class="mt-1 text-xs text-slate-500">Менять нельзя: партнёр присылает его в каждом
                                        запросе.</p>
                                    <% } else { %>
                                        <input type="number" name="serviceId" required min="1"
                                            value="<%= service && service.serviceId ? service.serviceId : '' %>"
                                            class="mt-1 block w-full rounded-md border-slate-300 shadow-sm text-sm">
                                        <p class="mt-1 text-xs text-slate-500">Выдаёт партнёр при подключении услуги.
                                        </p>
                                        <% } %>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-700">Название услуги</label>
                                <input type="text" name="name" required
                                    value="<%= service && service.name ? service.name : '' %>" placeholder="Microsoft"
                                    class="mt-1 block w-full rounded-md border-slate-300 shadow-sm text-sm">
                                <p class="mt-1 text-xs text-slate-500">То, что клиент видит в меню терминала.</p>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-700">Мерчант канала</label>
                                <select name="merchantId" required
                                    class="mt-1 block w-full rounded-md border-slate-300 shadow-sm text-sm">
                                    <option value="">— выберите —</option>
                                    <% merchants.forEach(m=> { %>
                                        <option value="<%= m.id %>" <%=service && Number(service.merchantId)===m.id
                                            ? 'selected' : '' %>>
                                            <%= m.username %>
                                        </option>
                                        <% }) %>
                                </select>
                                <p class="mt-1 text-xs text-slate-500">На него оформляются продажи этой услуги. Отдельный
                                    технический мерчант, не живая точка — иначе выручка канала попадёт в её баланс.</p>
                            </div>

                            <div>
                                <label class="block text-sm font-medium text-slate-700">Касса</label>
                                <select name="kassaId"
                                    class="mt-1 block w-full rounded-md border-slate-300 shadow-sm text-sm">
                                    <option value="">— не вести учёт по кассе —</option>
                                    <% kassas.forEach(k=> { %>
                                        <option value="<%= k.id %>" <%=service && Number(service.kassaId)===k.id
                                            ? 'selected' : '' %>>
                                            <%= k.name %>
                                        </option>
                                        <% }) %>
                                </select>
                                <p class="mt-1 text-xs text-slate-500">Необязательно. Партнёр рассчитывается
                                    банковским переводом, через кассу эти деньги не проходят — поле нужно только
                                    как метка принадлежности, чтобы сверять поступивший перевод. Оставьте пустым,
                                    если ведёте этот учёт вне системы: тогда ни один баланс кассы не затрагивается,
                                    а доля платформы всё равно фиксируется в каждой транзакции.</p>
                            </div>

                            <div class="border-t border-slate-200 pt-5">
                                <h3 class="text-sm font-semibold text-slate-900 mb-3">Доступ для партнёра (HTTP Basic)
                                </h3>
                                <label class="block text-sm font-medium text-slate-700">Логин</label>
                                <input type="text" name="login" required autocomplete="off"
                                    value="<%= service && service.login ? service.login : '' %>"
                                    class="mt-1 block w-full rounded-md border-slate-300 shadow-sm text-sm font-mono">

                                <label class="block text-sm font-medium text-slate-700 mt-4">Пароль</label>
                                <input type="text" name="password" autocomplete="off" <%=isEdit ? '' : 'required' %>
                                    placeholder="<%= isEdit ? 'оставьте пустым, чтобы не менять' : 'минимум 8 символов' %>"
                                    class="mt-1 block w-full rounded-md border-slate-300 shadow-sm text-sm font-mono">
                                <p class="mt-1 text-xs text-slate-500">Эту пару вы передаёте партнёру. Хранится хешем,
                                    посмотреть позже нельзя — только задать новый.</p>
                            </div>

                            <div class="flex items-center gap-2 border-t border-slate-200 pt-5">
                                <input type="checkbox" name="isActive" id="isActive" <%=!service || service.isActive
                                    ? 'checked' : '' %> class="rounded border-slate-300">
                                <label for="isActive" class="text-sm text-slate-700">Услуга включена</label>
                            </div>

                            <div class="flex items-center gap-3 pt-2">
                                <button type="submit"
                                    class="rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">
                                    <%= isEdit ? 'Сохранить' : 'Создать услугу' %>
                                </button>
                                <a href="/admin/partners"
                                    class="text-sm text-slate-600 hover:text-slate-900">Отмена</a>
                            </div>
                        </form>

                        <% if (isEdit) { %>
                            <div class="mt-6 rounded-lg bg-slate-100 p-4 text-sm text-slate-600">
                                <p class="font-medium text-slate-800 mb-1">Адрес для партнёра</p>
                                <code
                                    class="text-xs break-all">POST https://&lt;ваш-домен&gt;/api/payments/uws/<%= service.partner.toLowerCase() %></code>
                            </div>
                            <% } %>
            </div>
</body>

</html>
