<!DOCTYPE html>
<html lang="ru">

<head>
  <%- include('../partials/merchant/head', { title: 'Продажа товаров' }) %>
</head>

<body class="text-slate-900 antialiased">
  <% const cartCount=(cart || []).reduce((sum, item)=> sum + item.quantity, 0); %>

    <div class="m-shell">
      <%- include('../partials/merchant/sidebar', { active: 'sell', user, cartCount }) %>

        <div class="lg:pl-[260px] flex flex-col min-h-dvh">
          <%- include('../partials/merchant/topbar', { active: 'sell', user }) %>

            <main class="m-content flex-1 pb-24 lg:pb-10">
              <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
                <div class="m-fade-in flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                  <div>
                    <h1 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">Продажа товаров</h1>
                    <p class="mt-1 text-sm text-[var(--m-text-muted)]">Выберите товар и добавьте его в чек. Одна
                      продажа — один товар.</p>
                  </div>
                  <a href="/merchant/checkout" class="m-btn m-btn--secondary">
                    <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M2.25 3h1.386c.51 0 .955.343 1.087.836l.383 1.437m0 0L7.5 14.25a3 3 0 0 0 3 2.25h6a3 3 0 0 0 3-2.25l1.5-6.75H5.106M6 18.75a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Zm12.75 0a.75.75 0 1 1-1.5 0 .75.75 0 0 1 1.5 0Z" />
                    </svg>
                    Перейти к чеку
                    <% if (cartCount> 0) { %>
                      <span
                        class="rounded-full bg-[var(--m-primary)] text-white text-[11px] font-bold h-[18px] min-w-[18px] px-1 flex items-center justify-center">
                        <%= cartCount %>
                      </span>
                      <% } %>
                  </a>
                </div>

                <% if (typeof error !=='undefined' && error) { %>
                  <div
                    class="m-fade-in mt-5 flex items-start gap-2.5 rounded-lg bg-[var(--m-danger-bg)] px-4 py-3 text-sm text-[var(--m-danger)]">
                    <svg class="mt-0.5 h-4 w-4 flex-shrink-0" fill="none" stroke="currentColor"
                      viewBox="0 0 24 24">
                      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                        d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-2.5L13.732 4c-.77-.833-1.732-.833-2.5 0L4.314 15.5c-.77.833.192 2.5 1.732 2.5z" />
                    </svg>
                    <span>
                      <%= error %>
                    </span>
                  </div>
                  <% } %>

                    <div class="m-fade-in relative mt-6 max-w-sm">
                      <svg class="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-[var(--m-text-subtle)]"
                        fill="none" stroke="currentColor" viewBox="0 0 24 24">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                          d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z" />
                      </svg>
                      <input id="productSearch" type="text" inputmode="search" autocomplete="off"
                        placeholder="Поиск по ID или названию"
                        class="w-full rounded-lg border border-[var(--m-border-strong)] bg-white py-2.5 pl-9 pr-3 text-sm text-slate-900 shadow-sm outline-none transition focus:border-[var(--m-primary)] focus:ring-4 focus:ring-[var(--m-primary-bg)]" />
                    </div>

                    <% if (!products.length) { %>
                      <div class="m-card mt-6 px-8 py-16 text-center text-[var(--m-text-muted)]">
                        <h3 class="text-base font-semibold text-slate-700">Нет доступных товаров</h3>
                        <p class="mt-1.5 text-sm">Попросите администратора добавить продукты в каталог.</p>
                      </div>
                      <% } else { %>
                        <div class="m-fade-in mt-6 grid grid-cols-2 gap-3 sm:gap-4 lg:grid-cols-4"
                          id="productGrid">
                          <% products.forEach(product=> { %>
                            <% const inStock=(product.activeVoucherCount || 0)> 0; %>
                              <% const imageUrl=(product.images && product.images[0]) ? product.images[0].url
                                : '/images/product-placeholder.svg' ; %>
                                <article data-product-card
                                  data-name="<%= (product.name || '').toLowerCase() %>"
                                  data-id="<%= product.id %>"
                                  class="m-card flex flex-col overflow-hidden transition hover:-translate-y-0.5 hover:shadow-md">
                                  <div class="relative aspect-square w-full overflow-hidden bg-[var(--m-bg)]">
                                    <img src="<%= imageUrl %>" alt="<%= product.name %>"
                                      class="h-full w-full object-cover" />
                                    <div class="absolute right-2.5 top-2.5">
                                      <% if (inStock) { %>
                                        <span class="m-badge m-badge--success shadow-sm">В наличии ·
                                          <%= product.activeVoucherCount %>
                                        </span>
                                        <% } else { %>
                                          <span class="m-badge m-badge--danger shadow-sm">Нет в наличии</span>
                                          <% } %>
                                    </div>
                                  </div>

                                  <div class="flex flex-1 flex-col p-5">
                                    <h3 class="text-[15px] font-semibold leading-snug text-slate-900">
                                      <%= product.name %>
                                    </h3>
                                    <p class="mt-1 text-xs text-[var(--m-text-subtle)] font-numeric">Артикул #<%= product.id %></p>

                                    <div class="mt-4 flex-1"></div>

                                    <p class="text-2xl font-bold text-slate-900 font-numeric">
                                      <%= product.price.toLocaleString('ru-RU') %> <span
                                        class="text-sm font-medium text-[var(--m-text-subtle)]">сум</span>
                                    </p>

                                    <form method="POST" action="/merchant/add-to-cart" class="mt-4">
                                      <input type="hidden" name="productId" value="<%= product.id %>" />
                                      <button type="submit" <%= inStock ? '' : 'disabled' %>
                                        class="m-btn w-full py-2.5 <%= inStock ? 'm-btn--primary' : 'bg-slate-100 text-slate-400' %>">
                                        <svg class="h-4 w-4" fill="none" stroke="currentColor"
                                          viewBox="0 0 24 24">
                                          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                            d="M12 4.5v15m7.5-7.5h-15" />
                                        </svg>
                                        <%= inStock ? 'Добавить в чек' : 'Нет в наличии' %>
                                      </button>
                                    </form>
                                  </div>
                                </article>
                                <% }) %>
                        </div>
                        <p id="productSearchEmpty" class="hidden mt-10 text-center text-sm text-[var(--m-text-muted)]">
                          Ничего не найдено</p>
                        <% } %>
              </div>
            </main>
        </div>
    </div>

    <%- include('../partials/merchant/bottom-nav', { active: 'sell', cartCount }) %>

      <script src="/js/merchant-sell.js"></script>
</body>

</html>
