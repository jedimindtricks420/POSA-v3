<!DOCTYPE html>
<html lang="ru">

<head>
    <meta charset="UTF-8">
    <title>Партнёрские сети — POSA Admin</title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/css/admin.css" rel="stylesheet">
</head>

<body class="bg-slate-50 min-h-screen">
    <%- include('../partials/admin-navbar', { user }) %>

        <div class="max-w-[1700px] mx-auto px-4 sm:px-6 py-8 pt-20">
            <div class="md:flex md:items-center md:justify-between mb-2">
                <h2 class="text-2xl font-bold text-slate-900">Партнёрские сети</h2>
                <div class="flex items-center gap-3">
                    <a href="/admin/partner-journal"
                        class="inline-flex items-center rounded-md bg-white px-4 py-2 text-sm font-semibold text-slate-700 ring-1 ring-slate-300 hover:bg-slate-50">Журнал
                        транзакций</a>
                    <% if (user.role==='admin' ) { %>
                        <a href="/admin/partners/add"
                            class="inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white hover:bg-indigo-500">+
                            Добавить услугу</a>
                        <% } %>
                </div>
            </div>
            <p class="text-sm text-slate-500 mb-6">Услуга — это пункт в меню терминала партнёра. Внутри услуги лежат
                позиции: клиент выбирает позицию, вводит номер телефона и платит.</p>

            <div class="bg-white rounded-lg shadow-sm ring-1 ring-slate-200 overflow-x-auto">
                <table class="min-w-full divide-y divide-slate-200">
                    <thead class="bg-slate-50">
                        <tr>
                            <th class="px-3 py-3 text-left text-xs font-medium text-slate-500 uppercase whitespace-nowrap">Канал</th>
                            <th class="px-3 py-3 text-left text-xs font-medium text-slate-500 uppercase">Услуга</th>
                            <th class="px-3 py-3 text-left text-xs font-medium text-slate-500 uppercase">Логин</th>
                            <th class="px-3 py-3 text-left text-xs font-medium text-slate-500 uppercase">Касса</th>
                            <th class="px-3 py-3 text-left text-xs font-medium text-slate-500 uppercase">Мерчант</th>
                            <th class="px-3 py-3 text-left text-xs font-medium text-slate-500 uppercase whitespace-nowrap">Поз.</th>
                            <th class="px-3 py-3 text-left text-xs font-medium text-slate-500 uppercase whitespace-nowrap">Ост.</th>
                            <th class="px-3 py-3 text-left text-xs font-medium text-slate-500 uppercase whitespace-nowrap">Прод.</th>
                            <th class="px-3 py-3 text-left text-xs font-medium text-slate-500 uppercase">Статус</th>
                            <th class="px-3 py-3"></th>
                        </tr>
                    </thead>
                    <tbody class="divide-y divide-slate-200">
                        <% services.forEach(s=> { %>
                            <tr>
                                <td class="px-3 py-3 text-sm whitespace-nowrap">
                                    <span class="text-slate-500 text-xs"><%= s.partner %></span>
                                    <span class="font-mono text-slate-900 ml-1"><%= s.serviceId %></span>
                                </td>
                                <td class="px-3 py-3 text-sm font-medium text-slate-900">
                                    <%= s.name %>
                                </td>
                                <td class="px-3 py-3 text-sm font-mono text-slate-600 whitespace-nowrap">
                                    <%= s.login %>
                                </td>
                                <td class="px-3 py-3 text-sm text-slate-600">
                                    <%= s.kassa ? s.kassa.name : '— не задана' %>
                                </td>
                                <td class="px-3 py-3 text-sm text-slate-600">
                                    <%= s.merchant.username %>
                                </td>
                                <td class="px-3 py-3 text-sm text-slate-600">
                                    <%= s._count.items %>
                                </td>
                                <td class="px-3 py-3 text-sm">
                                    <% if (s.minStock===null) { %>
                                        <span class="text-slate-400">—</span>
                                        <% } else { %>
                                            <span
                                                class="<%= s.minStock === 0 ? 'text-red-600 font-semibold' : (s.minStock < 10 ? 'text-amber-600 font-medium' : 'text-slate-600') %>">
                                                <%= s.minStock %>
                                            </span>
                                            <% if (s.minStock===0) { %><span class="text-xs text-red-500">нет
                                                ваучеров</span><% } %>
                                                    <% } %>
                                </td>
                                <td class="px-3 py-3 text-sm text-slate-600">
                                    <%= s._count.transactions %>
                                </td>
                                <td class="px-3 py-3 text-sm">
                                    <span class="inline-flex items-center rounded-full px-2 py-0.5 text-xs font-medium
                      <%= s.isActive ? 'bg-emerald-100 text-emerald-700' : 'bg-slate-200 text-slate-600' %>">
                                        <%= s.isActive ? 'Включена' : 'Выключена' %>
                                    </span>
                                </td>
                                <td class="px-3 py-3 text-sm text-right whitespace-nowrap">
                                    <a href="/admin/partners/<%= s.id %>/items"
                                        class="text-indigo-600 hover:text-indigo-500">Позиции</a>
                                    <% if (user.role==='admin' ) { %>
                                        <a href="/admin/partners/<%= s.id %>/edit"
                                            class="ml-3 text-slate-600 hover:text-slate-900">Настройки</a>
                                        <form method="POST" action="/admin/partners/<%= s.id %>/toggle"
                                            class="inline ml-3">
                                            <button type="submit" class="text-slate-500 hover:text-slate-800">
                                                <%= s.isActive ? 'Выключить' : 'Включить' %>
                                            </button>
                                        </form>
                                        <% } %>
                                </td>
                            </tr>
                            <% }) %>
                                <% if (services.length===0) { %>
                                    <tr>
                                        <td colspan="10" class="px-6 py-10 text-center text-sm text-slate-400">
                                            Услуг пока нет. Добавьте первую — это будет пункт в меню терминала партнёра.
                                        </td>
                                    </tr>
                                    <% } %>
                    </tbody>
                </table>
            </div>
        </div>
</body>

</html>
