<!DOCTYPE html>
<html lang="ru">

<head>
  <%- include('../partials/merchant/head', { title: 'История продаж' }) %>
</head>

<body class="text-slate-900 antialiased">
  <% const totalSales=sales.length; %>
    <% const onlineSales=sales.filter(sale=> sale.saleType === 'ONLINE').length; %>
      <% const offlineSales=totalSales - onlineSales; %>
        <% const totalAmount=sales.reduce((sum, sale)=> sum + sale.price, 0); %>
          <% const merchantDebtValue=Number(merchantDebt || 0); %>

            <div class="m-shell">
              <%- include('../partials/merchant/sidebar', { active: 'sales', user }) %>

                <div class="lg:pl-[260px] flex flex-col min-h-dvh">
                  <%- include('../partials/merchant/topbar', { active: 'sales', user }) %>

                    <main class="m-content flex-1 pb-24 lg:pb-10">
                      <div class="mx-auto max-w-6xl px-4 py-6 sm:px-6 lg:px-8 lg:py-8">
                        <div class="m-fade-in flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
                          <div>
                            <h1 class="text-xl font-bold tracking-tight text-slate-900 sm:text-2xl">История продаж</h1>
                            <p class="mt-1 text-sm text-[var(--m-text-muted)]">Все оформленные чеки в обратном
                              хронологическом порядке.</p>
                          </div>
                          <div class="flex gap-2.5">
                            <a href="/merchant/sell" class="m-btn m-btn--primary flex-1 sm:flex-none">
                              <svg class="h-4 w-4" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M12 4.5v15m7.5-7.5h-15" />
                              </svg>
                              Новая продажа
                            </a>
                          </div>
                        </div>

                        <div class="m-fade-in mt-6 grid grid-cols-2 gap-3 lg:grid-cols-4">
                          <div class="m-stat">
                            <p class="text-xs font-medium text-[var(--m-text-subtle)]">Всего продаж</p>
                            <p class="mt-1.5 text-2xl font-bold text-slate-900 font-numeric">
                              <%= totalSales %>
                            </p>
                          </div>
                          <div class="m-stat">
                            <p class="text-xs font-medium text-[var(--m-text-subtle)]">Каналы</p>
                            <div class="mt-1.5 space-y-0.5">
                              <div class="flex items-baseline gap-1.5">
                                <span class="text-lg font-bold text-[var(--m-success)] font-numeric">
                                  <%= onlineSales %>
                                </span>
                                <span class="text-xs text-[var(--m-text-subtle)]">онлайн</span>
                              </div>
                              <div class="flex items-baseline gap-1.5">
                                <span class="text-lg font-bold text-slate-900 font-numeric">
                                  <%= offlineSales %>
                                </span>
                                <span class="text-xs text-[var(--m-text-subtle)]">офлайн</span>
                              </div>
                            </div>
                          </div>
                          <div class="m-stat">
                            <p class="text-xs font-medium text-[var(--m-text-subtle)]">Сумма продаж</p>
                            <p class="mt-1.5 text-xl font-bold text-slate-900 font-numeric">
                              <%= totalAmount.toLocaleString('ru-RU') %> <span
                                class="text-sm font-medium text-[var(--m-text-subtle)]">сум</span>
                            </p>
                          </div>
                          <div class="m-stat">
                            <p class="text-xs font-medium text-[var(--m-text-subtle)]">Долг к выплате</p>
                            <p class="mt-1.5 text-xl font-bold text-[var(--m-danger)] font-numeric">
                              <%= merchantDebtValue.toLocaleString('ru-RU') %> <span
                                class="text-sm font-medium text-[var(--m-text-subtle)]">сум</span>
                            </p>
                          </div>
                        </div>

                        <div class="m-fade-in mt-6">
                          <% if (!sales.length) { %>
                            <div class="m-card px-8 py-16 text-center">
                              <div
                                class="mx-auto flex h-14 w-14 items-center justify-center rounded-full bg-[var(--m-primary-bg)] text-[var(--m-primary)]">
                                <svg class="h-6 w-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                                  <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                    d="M20 13V6a2 2 0 00-2-2H6a2 2 0 00-2 2v7m16 0v5a2 2 0 01-2 2H6a2 2 0 01-2-2v-5m16 0h-2.586a1 1 0 00-.707.293l-2.414 2.414a1 1 0 01-.707.293H9.414a1 1 0 01-.707-.293L6.293 13.293A1 1 0 005.586 13H4" />
                                </svg>
                              </div>
                              <h2 class="mt-5 text-base font-semibold text-slate-900">История пока пустая</h2>
                              <p class="mt-1.5 text-sm text-[var(--m-text-muted)]">Оформите первую продажу — и она
                                сразу появится здесь.</p>
                              <a href="/merchant/sell" class="m-btn m-btn--primary mt-5 inline-flex">Перейти к
                                каталогу</a>
                            </div>
                            <% } else { %>
                              <div class="m-card overflow-hidden">
                                <div
                                  class="flex items-center justify-between border-b border-[var(--m-border)] px-5 py-3.5">
                                  <h2 class="text-sm font-semibold text-slate-900">Транзакции</h2>
                                  <span class="m-badge m-badge--neutral">Всего:
                                    <%= totalSales %>
                                  </span>
                                </div>
                                <div class="m-table-wrap">
                                  <table class="m-table">
                                    <thead>
                                      <tr>
                                        <th>Товар</th>
                                        <th>Тип</th>
                                        <th>Телефон</th>
                                        <th>Код ваучера</th>
                                        <th>Дата</th>
                                        <th class="text-right">Сумма</th>
                                      </tr>
                                    </thead>
                                    <tbody>
                                      <% sales.forEach((sale)=> { %>
                                        <tr>
                                          <td data-label="Товар">
                                            <p class="font-semibold text-slate-900">
                                              <%= sale.productName %>
                                            </p>
                                            <p class="mt-0.5 text-xs text-[var(--m-text-subtle)] font-numeric">#<%= sale.productId %></p>
                                          </td>
                                          <td data-label="Тип">
                                            <% if (sale.saleType==='ONLINE' ) { %>
                                              <span class="m-badge m-badge--success m-badge--dot">Онлайн</span>
                                              <% } else { %>
                                                <span class="m-badge m-badge--neutral m-badge--dot">Офлайн</span>
                                                <% } %>
                                          </td>
                                          <td data-label="Телефон"><span class="text-slate-600">
                                              <%= sale.customerPhone || '—' %>
                                            </span></td>
                                          <td data-label="Ваучер"><code
                                              class="rounded bg-slate-100 px-2 py-1 text-xs font-mono text-slate-700">
                                              <%= sale.maskedVoucher || sale.voucherValue %>
                                            </code></td>
                                          <td data-label="Дата"><span class="text-slate-600">
                                              <%= new Date(sale.date).toLocaleString('ru-RU', { day: '2-digit', month: '2-digit', year: 'numeric', hour: '2-digit', minute: '2-digit' }) %>
                                            </span></td>
                                          <td data-label="Сумма" class="md:text-right"><span
                                              class="font-semibold text-slate-900 font-numeric">
                                              <%= sale.price.toLocaleString('ru-RU') %> сум
                                            </span></td>
                                        </tr>
                                        <% }) %>
                                    </tbody>
                                  </table>
                                </div>
                              </div>
                              <% } %>
                        </div>
                      </div>
                    </main>
                </div>
            </div>

            <%- include('../partials/merchant/bottom-nav', { active: 'sales' }) %>
</body>

</html>
