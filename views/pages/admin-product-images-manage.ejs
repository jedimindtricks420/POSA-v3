<% if (user.role==='admin' || user.role==='content_mgr' ) { %>
  <!DOCTYPE html>
  <html lang="ru">

  <head>
    <meta charset="UTF-8">
    <title>Изображения — <%= product.name %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="/css/admin.css" rel="stylesheet">
  </head>

  <body class="bg-slate-50 min-h-screen">
    <%- include('../partials/admin-navbar', { user }) %>

      <div class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-8 pt-20">
        <div class="mb-6">
          <a href="/admin/product-images" class="text-sm text-indigo-600 hover:text-indigo-500">&larr; К списку товаров</a>
          <h2 class="mt-2 text-2xl font-bold leading-7 text-slate-900 sm:text-3xl sm:tracking-tight">
            <%= product.name %>
          </h2>
          <p class="mt-1 text-sm text-slate-500">ID товара: <%= product.id %></p>
        </div>

        <% if (error) { %>
          <div class="rounded-md bg-red-50 p-4 mb-6">
            <div class="text-sm text-red-700"><%= error %></div>
          </div>
          <% } %>

            <!-- Форма загрузки -->
            <section class="bg-white shadow-sm ring-1 ring-slate-200 rounded-xl p-6 mb-8">
              <h3 class="text-sm font-semibold text-slate-900 mb-4">Загрузить новое изображение</h3>
              <form action="/admin/product-images/<%= product.id %>/upload" method="POST" enctype="multipart/form-data"
                class="flex flex-col sm:flex-row gap-3 sm:items-center">
                <input type="file" name="image" accept="image/png,image/jpeg,image/jpg,image/gif,image/svg+xml,image/webp"
                  required
                  class="block w-full text-sm text-slate-600 file:mr-4 file:rounded-md file:border-0 file:bg-indigo-50 file:px-4 file:py-2 file:text-sm file:font-semibold file:text-indigo-700 hover:file:bg-indigo-100" />
                <button type="submit"
                  class="inline-flex items-center justify-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500 whitespace-nowrap">
                  Загрузить
                </button>
              </form>
              <p class="mt-2 text-xs text-slate-400">JPG, PNG, GIF, SVG, WEBP — до 5 МБ. Первое загруженное фото
                автоматически становится главным.</p>
            </section>

            <!-- Галерея -->
            <section>
              <h3 class="text-sm font-semibold text-slate-900 mb-4">Изображения товара (<%= product.images.length %>)
              </h3>

              <% if (!product.images.length) { %>
                <div class="rounded-xl border border-dashed border-slate-300 bg-white p-10 text-center text-slate-500">
                  <img src="/images/product-placeholder.svg" alt="" class="mx-auto h-16 w-16 mb-3" />
                  <p>У этого товара пока нет изображений. Клиенты будут видеть плейсхолдер.</p>
                </div>
                <% } else { %>
                  <div class="grid grid-cols-2 gap-4 sm:grid-cols-3 lg:grid-cols-4">
                    <% product.images.forEach(image=> { %>
                      <div
                        class="relative rounded-xl overflow-hidden bg-white ring-1 ring-slate-200 shadow-sm group">
                        <img src="<%= image.url %>" alt="" class="h-40 w-full object-cover bg-slate-50" />

                        <% if (image.isPrimary) { %>
                          <span
                            class="absolute top-2 left-2 inline-flex items-center rounded-full bg-green-100 px-2 py-0.5 text-xs font-medium text-green-700 ring-1 ring-inset ring-green-600/20">
                            Главное
                          </span>
                          <% } %>

                            <div class="p-2 flex gap-2">
                              <% if (!image.isPrimary) { %>
                                <form action="/admin/product-images/image/<%= image.id %>/primary" method="POST"
                                  class="flex-1">
                                  <button type="submit"
                                    class="w-full inline-flex items-center justify-center rounded-md bg-slate-50 px-2 py-1.5 text-xs font-semibold text-slate-700 ring-1 ring-inset ring-slate-300 hover:bg-slate-100">
                                    Сделать главным
                                  </button>
                                </form>
                                <% } %>
                                  <form action="/admin/product-images/image/<%= image.id %>/delete" method="POST"
                                    class="<%= image.isPrimary ? 'flex-1' : '' %>">
                                    <button type="submit"
                                      onclick="return confirm('Удалить это изображение?')"
                                      class="w-full inline-flex items-center justify-center rounded-md bg-red-50 px-2 py-1.5 text-xs font-semibold text-red-600 ring-1 ring-inset ring-red-500/10 hover:bg-red-100">
                                      Удалить
                                    </button>
                                  </form>
                            </div>
                      </div>
                      <% }) %>
                  </div>
                  <% } %>
            </section>
      </div>
  </body>

  </html>
  <% } else { %>
    <!DOCTYPE html>
    <html lang="ru">

    <head>
      <meta charset="UTF-8">
      <title>Доступ запрещен</title>
      <meta name="viewport" content="width=device-width, initial-scale=1.0">
      <script src="https://cdn.tailwindcss.com"></script>
      <link href="/css/admin.css" rel="stylesheet">
    </head>

    <body class="bg-slate-50 min-h-screen">
      <%- include('../partials/admin-navbar', { user }) %>

      <div class="flex min-h-screen items-center justify-center px-4 py-8 pt-20">
        <div class="w-full max-w-md text-center">
          <div class="rounded-lg bg-white p-8 shadow-lg">
            <h1 class="mt-4 text-2xl font-bold text-slate-900">Доступ запрещен</h1>
            <p class="mt-2 text-slate-600">У вас нет прав для просмотра этой страницы.</p>
            <a href="/admin/dashboard"
              class="mt-6 inline-flex items-center rounded-md bg-indigo-600 px-4 py-2 text-sm font-semibold text-white shadow-sm hover:bg-indigo-500">
              Вернуться на главную
            </a>
          </div>
        </div>
      </div>
    </body>

    </html>
    <% } %>
