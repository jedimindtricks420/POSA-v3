<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover, maximum-scale=1" />
  <meta name="mobile-web-app-capable" content="yes" />
  <meta name="theme-color" content="#9EE52D" />
  <meta name="apple-mobile-web-app-capable" content="yes" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" />
  <meta name="apple-mobile-web-app-status-bar-style" content="black" media="(prefers-color-scheme: light)">
  <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent" media="(prefers-color-scheme: dark)">
  <meta name="apple-mobile-web-app-title" content="Namo Wallet" />
  <link rel="manifest" href="/manifest.json" />
  <link rel="apple-touch-icon" href="/images/icon-192.png" />
  <link rel="icon" type="image/png" sizes="32x32" href="/images/icon-192.png" />
  <script>
    window.__APP_ROLE__ = 'Client';
    window.__APP_BASE_URL__ = <%- JSON.stringify(appBaseUrl || null) %> || window.location.origin;
  </script>
  <!-- Manrope font -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Manrope:wght@400..800&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="/css/client.css" />
  <link rel="stylesheet" href="/css/client-overrides.css" />
  <!-- Manrope только для клиентского кошелька: client.css/client-overrides.css
       используются и страницами оплаты (pay-product и т.п.), поэтому шрифт
       переопределяем точечно тут, а не в tailwind.config.js (font-sans),
       чтобы не задеть чек-аут. -->
  <style>
    body { font-family: 'Manrope', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, 'Helvetica Neue', Arial, sans-serif !important; }
  </style>
  <title><%= title || 'Digital Wallet' %></title>
</head>
